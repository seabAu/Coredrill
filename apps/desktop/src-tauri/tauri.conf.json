{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coredrill",
  "version": "0.0.0",
  "identifier": "app.coredrill.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Coredrill",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "object-src": "'none'",
        "style-src": "'self'"
      },
      "freezePrototype": true
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": false
  }
}
