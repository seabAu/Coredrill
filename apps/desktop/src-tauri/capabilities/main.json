{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Allow only Coredrill's reviewed native database, recovery archive, and OS secure-storage commands from the bundled main window.",
  "local": true,
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "allow-native-storage-invoke",
    "allow-native-secret-invoke",
    "allow-native-archive-invoke",
    "allow-native-vault-invoke"
  ]
}
