{
  "name": "@coredrill/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "User-invoked, least-privilege Coredrill browser capture surface.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "wxt build -b chrome --mv3",
    "typecheck": "wxt prepare && tsc --noEmit --pretty false",
    "lint": "wxt prepare && eslint entrypoints src wxt.config.ts --max-warnings 0"
  },
  "dependencies": {
    "@coredrill/capture-core": "workspace:*",
    "@coredrill/extension-bridge": "workspace:*",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@wxt-dev/module-react": "1.2.2",
    "wxt": "0.21.4"
  }
}
