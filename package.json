{
  "name": "coredrill",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "build": "node tooling/scripts/run-turbo.mjs run build",
    "typecheck": "node tooling/scripts/run-turbo.mjs run typecheck",
    "lint": "node tooling/scripts/run-turbo.mjs run lint && eslint tooling --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --exclude packages/storage-native/test/native-database.test.ts",
    "test:security": "vitest run tooling/tests/phase-1-security.test.mjs packages/search-filter/test/filter-ast.test.ts packages/documents/test/document-ir.test.ts packages/observability/test/diagnostics.test.ts packages/application/test/diagnostics.test.ts packages/storage-core/test/portable-archive-restore.test.ts packages/storage-core/test/portable-archive-writer.test.ts",
    "test:coverage": "vitest run --coverage --exclude packages/storage-native/test/native-database.test.ts",
    "test:storage-browser": "playwright test --config=playwright.storage.config.mjs",
    "test:documents-browser": "playwright test --config=playwright.documents.config.mjs",
    "test:ui-foundations": "playwright test --config=playwright.ui-foundations.config.mjs",
    "test:app-shell": "playwright test --config=playwright.app-shell.config.mjs",
    "test:performance": "playwright test --config=playwright.performance.config.mjs",
    "test:resilience": "playwright test --config=playwright.resilience.config.mjs",
    "test:onboarding": "playwright test --config=playwright.onboarding.config.mjs",
    "test:storage-firefox-webdriver": "node tooling/scripts/run-storage-firefox-webdriver.mjs",
    "test:extension-transfer": "playwright test --config=playwright.extension.config.mjs",
    "test:storage-native": "pnpm --filter @coredrill/storage-core build && pnpm --filter @coredrill/desktop test:native-core && pnpm --filter @coredrill/desktop build:native-probe && vitest run packages/storage-native/test/native-database.test.ts",
    "test:secure-storage": "node tooling/scripts/run-native-secret-proof.mjs",
    "test:native-archive": "node tooling/scripts/run-native-archive-proof.mjs",
    "test:native-package": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/scripts/run-native-package-proof.ps1",
    "test:native-platform-package": "node tooling/scripts/run-native-platform-package-proof.mjs",
    "test:boundaries": "vitest run tooling/tests/import-boundaries.test.mjs",
    "check:boundaries": "node tooling/architecture/check-boundaries.mjs",
    "check:foundation-records": "node tooling/scripts/check-foundation-records.mjs",
    "check:extension-build": "node tooling/scripts/check-extension-build.mjs",
    "check:extension-packages": "node tooling/scripts/check-extension-packages.mjs",
    "package:extension:firefox-source": "pnpm --filter @coredrill/contracts build && pnpm --filter @coredrill/capture-core build && pnpm --filter @coredrill/extension-bridge build && pnpm --filter @coredrill/extension package:firefox",
    "test:extension-source-package": "node tooling/scripts/check-extension-packages.mjs --rebuild-source",
    "generate:contract-schemas": "node tooling/scripts/generate-contract-schemas.mjs",
    "check:contract-schemas": "node tooling/scripts/generate-contract-schemas.mjs --check",
    "generate:ui-contrast-report": "node tooling/scripts/generate-ui-contrast-report.mjs",
    "check:ui-contrast-report": "node tooling/scripts/generate-ui-contrast-report.mjs --check",
    "check:affected": "node tooling/scripts/check-affected.mjs",
    "check:licenses": "node tooling/scripts/check-licenses.mjs && node tooling/scripts/check-rust-licenses.mjs",
    "report:licenses": "pnpm licenses list --json",
    "report:licenses:rust": "node tooling/scripts/check-rust-licenses.mjs --json",
    "report:migrations": "node tooling/scripts/report-migration-inventory.mjs",
    "check:secrets": "node tooling/scripts/check-secrets.mjs",
    "check:policy": "pnpm check:boundaries && pnpm check:foundation-records && pnpm check:licenses && pnpm check:secrets",
    "audit:dependencies": "pnpm audit --audit-level=low && cargo audit --file apps/desktop/src-tauri/Cargo.lock",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "verify": "pnpm format:check && pnpm check:boundaries && pnpm check:foundation-records && pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:coverage && pnpm build && pnpm check:ui-contrast-report && pnpm check:extension-build && pnpm check:extension-packages && pnpm test:ui-foundations && pnpm test:app-shell && pnpm test:performance && pnpm test:resilience && pnpm test:onboarding && pnpm test:documents-browser && pnpm test:storage-browser && pnpm test:storage-native && pnpm test:secure-storage && pnpm test:native-archive && pnpm check:contract-schemas && pnpm check:licenses && pnpm check:secrets && pnpm audit:dependencies && pnpm changeset:status"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "3.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.12.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.0",
    "fast-check": "4.9.0",
    "license-checker-rseidelsohn": "5.0.1",
    "prettier": "3.9.6",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
