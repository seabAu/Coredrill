{
  "name": "@coredrill/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Versioned serialized boundary contracts; no runtime adapters.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/capture-envelope.v1.json": "./schemas/capture-envelope.v1.schema.json",
    "./schemas/diagnostic-event.v1.json": "./schemas/diagnostic-event.v1.schema.json",
    "./schemas/portable-archive-manifest.v1.json": "./schemas/portable-archive-manifest.v1.schema.json",
    "./schemas/portable-data-export.v1.json": "./schemas/portable-data-export.v1.schema.json",
    "./schemas/support-bundle.v1.json": "./schemas/support-bundle.v1.schema.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false --tsBuildInfoFile .turbo/typecheck.tsbuildinfo && tsc -p tsconfig.test.json --noEmit --pretty false --tsBuildInfoFile .turbo/typecheck-test.tsbuildinfo",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
