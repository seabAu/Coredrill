{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.coredrill.local/capture-envelope/v1.json",
  "type": "object",
  "properties": {
    "specVersion": { "type": "number", "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "captureMethod": {
      "type": "string",
      "enum": ["extension", "paste", "file", "connector", "manual"]
    },
    "sender": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["browser_extension", "web_app", "desktop_app", "import_tool"]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!\\s)(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[\\s\\S]*\\S$"
        }
      },
      "required": ["kind", "id"],
      "additionalProperties": false
    },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22,128}$" },
    "source": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 8192,
          "pattern": "^https?:\\/\\/(?![^/?#]*@)[^\\s]+$"
        },
        "canonicalUrl": {
          "type": "string",
          "maxLength": 8192,
          "pattern": "^https?:\\/\\/(?![^/?#]*@)[^\\s]+$"
        },
        "pageTitle": { "type": "string", "maxLength": 1024 },
        "sourceKind": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "externalId": { "type": "string", "maxLength": 512 }
      },
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "jsonLd": { "maxItems": 64, "type": "array", "items": { "$ref": "#/$defs/__schema0" } },
        "selectedText": { "type": "string", "maxLength": 65536 },
        "readableText": { "type": "string", "maxLength": 524288 },
        "sanitizedHtml": { "type": "string", "maxLength": 1048576 },
        "apiPayload": { "$ref": "#/$defs/__schema0" }
      },
      "additionalProperties": false
    },
    "fieldCandidates": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "specVersion": { "type": "number", "const": 1 },
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "fieldName": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          },
          "value": { "$ref": "#/$defs/__schema0" },
          "rawValue": { "$ref": "#/$defs/__schema0" },
          "provenance": {
            "type": "object",
            "properties": {
              "specVersion": { "type": "number", "const": 1 },
              "source": {
                "type": "object",
                "properties": {
                  "sourceType": {
                    "type": "string",
                    "maxLength": 128,
                    "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
                  },
                  "sourceId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "pointer": {
                    "type": "string",
                    "maxLength": 2048,
                    "pattern": "^(?!\\s)(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[\\s\\S]*\\S$"
                  }
                },
                "required": ["sourceType", "sourceId", "pointer"],
                "additionalProperties": false
              },
              "method": {
                "type": "string",
                "enum": ["api", "jsonld", "selector", "readability", "heuristic", "llm", "user"]
              },
              "extractor": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 128,
                    "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
                  },
                  "version": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
                  }
                },
                "required": ["name", "version"],
                "additionalProperties": false
              },
              "capturedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
              },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "sourceExcerpt": { "type": "string", "maxLength": 4096 },
              "licenseNote": { "type": "string", "maxLength": 1024 }
            },
            "required": [
              "specVersion",
              "source",
              "method",
              "extractor",
              "capturedAt",
              "confidence"
            ],
            "additionalProperties": false
          },
          "userConfirmation": {
            "type": "object",
            "properties": {
              "specVersion": { "type": "number", "const": 1 },
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "actor": { "type": "string", "const": "user" },
              "confirmedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
              },
              "confirmedValueHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "required": ["specVersion", "id", "actor", "confirmedAt", "confirmedValueHash"],
            "additionalProperties": false
          }
        },
        "required": ["specVersion", "id", "fieldName", "value", "provenance"],
        "additionalProperties": false
      }
    },
    "captureClient": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "required": [
    "specVersion",
    "id",
    "capturedAt",
    "expiresAt",
    "captureMethod",
    "sender",
    "sequence",
    "nonce",
    "source",
    "content",
    "fieldCandidates",
    "captureClient",
    "contentHash"
  ],
  "additionalProperties": false,
  "title": "Coredrill CaptureEnvelopeV1",
  "description": "A size-bounded, checksummed, replay-identifiable envelope for user-invoked capture inputs and their source-backed field candidates.",
  "x-coredrill-maxBytes": 2097152,
  "x-coredrill-compatibility": {
    "policy": "current-and-previous",
    "currentSpecVersion": 1,
    "acceptedSpecVersions": [1]
  },
  "$defs": {
    "__schema0": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema0" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema0" }
        }
      ]
    }
  }
}
