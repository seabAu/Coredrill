{
  "name": "@coredrill/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared accessible product views and components; no SQL or privileged APIs.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false --tsBuildInfoFile .turbo/typecheck.tsbuildinfo && tsc -p tsconfig.test.json --pretty false",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@coredrill/application": "workspace:*",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "lucide-react": "1.35.0"
  },
  "peerDependencies": {
    "react": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
