{
  "name": "@job-workspace/application",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Use-case orchestration and query DTOs over domain ports.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false --tsBuildInfoFile .turbo/typecheck.tsbuildinfo",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@job-workspace/contracts": "workspace:*",
    "@job-workspace/domain": "workspace:*"
  }
}
