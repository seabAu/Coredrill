{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "noUpdateNotifier": true,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../tooling/typescript/**"],
      "outputs": ["dist/**", ".turbo/build.tsbuildinfo"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../tooling/typescript/**"],
      "outputs": [".turbo/typecheck.tsbuildinfo"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "../../eslint.config.mjs"],
      "outputs": []
    }
  }
}
