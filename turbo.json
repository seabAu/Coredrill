{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../tooling/typescript/**"],
      "outputs": ["dist/**", "../../.turbo/tsbuildinfo/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "../../tooling/typescript/**"],
      "outputs": ["../../.turbo/tsbuildinfo/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "../../eslint.config.mjs"],
      "outputs": []
    }
  }
}
